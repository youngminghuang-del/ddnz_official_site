    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/blog/top-10-commercial-dishwasher-manufacturers-china/#faq",
      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which manufacturer should a new importer contact first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start with the machine type your customers already request. For OEM, include DAVOSA in the comparison; for a specialist branded range, examine Veetsan. Send DDNZ your customer type and destination so we can narrow the supply brief before discussing trial quantities."
          }
        },
        {
          "@type": "Question",
          "name": "Can I trial a small quantity at a factory price?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ask for a standard-model trial first. DDNZ can propose model-specific low-MOQ options; logo changes, packaging and electrical customisation need separate confirmation. Compare the written configuration and shipping terms, rather than treating a small-order unit price as an all-in cost."
          }
        },
        {
          "@type": "Question",
          "name": "What should I request for after-sales support?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Request the exact model’s parts list, wiring diagram, service instructions and warranty procedure before ordering. Name the local technician or service partner who will handle installation and repairs, and agree the price and freight responsibility for replacement parts."
          }
        },
        {
          "@type": "Question",
          "name": "Can DDNZ help if I only have a kitchen drawing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Send the floor plan, menu or operation type, destination and expected busy-service load. We can start with the wash-up layout and equipment plan, then develop the purchasing list and factory-price supply options."
          }
        }
      ]
    },
