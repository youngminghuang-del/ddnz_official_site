    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/tr/blog/istanbul-restoran-mutfak-ekipmanlari-cinden-tedarik/#faq",
      "inLanguage": "tr",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Tek bir restoran için Çin’den ekipman alabilir miyim?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Evet. DDNZ tek restoran için ekipman planı ve tedarik seçenekleri hazırlayabilir. Standart cihazlarda düşük minimum sipariş imkanları model bazında belirlenir; özel imalat koşulları ayrıca fiyatlanır."
          }
        },
        {
          "@type": "Question",
          "name": "BOQ veya profesyonel çizimim yoksa ne göndermeliyim?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Menünüzü, ölçülü bir krokiyi, mutfak fotoğraflarını, bütçenizi ve açılış tarihinizi gönderin. Mevcut elektrik, gaz ve su bilgilerini de ekleyin. İlk ekipman listesi bu bilgilerle oluşturulabilir."
          }
        },
        {
          "@type": "Question",
          "name": "Fabrika fiyatına İstanbul’a teslimat ve montaj dahil mi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yalnızca yazılı teklifte dahil olduğu belirtilmişse. Cihaz fiyatını, nakliyeyi, ithalat giderlerini, boşaltmayı ve montajı ayrı görün. Teklifte teslim yerinin açıkça yazılmasını isteyin."
          }
        },
        {
          "@type": "Question",
          "name": "Çin’den gelen cihaz bozulursa ne olacak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Siparişten önce yerel onarımı yapacak firmayı ve satıcının teknik destek kapsamını belirleyin. Model ve seri numarasını saklayın; uygun yedek parça listesini alın. Garanti, yerel işçilik ve parça gönderim ücretlerini ayrı ayrı yazılı hale getirin."
          }
        }
      ]
    },
