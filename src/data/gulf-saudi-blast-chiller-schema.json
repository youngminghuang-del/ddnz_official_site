    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/ar/blog/saudi-central-kitchen-blast-chiller-5-vs-10-trays/#faq",
      "inLanguage": "ar",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "متى يكفي مبرد سريع بخمس صوانٍ؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "عندما تتسع الصواني الفعلية لأكبر دفعة ويمكن للموديل تبريد وزنها إلى هدف قلب الطعام ضمن الوقت المتاح، بما في ذلك تتابع الدورات عند الذروة."
          }
        },
        {
          "@type": "Question",
          "name": "هل يبرد جهاز العشر صواني ضعف حمولة جهاز الخمس؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "قارن الحمولة التي أثبتها كل موديل في ظروف اختبار متكافئة. عدد مواضع الصواني يحدد ترتيب الحمولة داخل الجهاز، وتحدد نتيجة الاختبار كم كيلوغرامًا يصل إلى درجة الهدف خلال الوقت المتفق عليه."
          }
        },
        {
          "@type": "Question",
          "name": "ماذا أسجل عند استلام الجهاز؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "سجّل الموديل وتوزيع الصواني ووزن الطعام ووقت الدورة وقراءات حرارة القلب في المواضع المتفق عليها. أرفق السجل بمحضر القبول وقارنه بمواصفات طلب الشراء."
          }
        }
      ]
    },
