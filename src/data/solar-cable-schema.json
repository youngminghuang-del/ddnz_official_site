    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/es/blog/cables-carga-solar-mayoreo-china/#faq",
      "inLanguage": "es",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Puedo pedir cotización sin conocimientos eléctricos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí. Envía país, modelo de estación, fotos de ambos conectores, distancia y cantidad. Solicita al proveedor la identificación técnica y una propuesta por escrito antes de aprobar la muestra."
          }
        },
        {
          "@type": "Question",
          "name": "¿Un cable MC4 a XT60 sirve para todas las estaciones?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Debe coincidir con el modelo, la variante de entrada, la polaridad y los límites eléctricos del conjunto."
          }
        },
        {
          "@type": "Question",
          "name": "¿El color distingue siempre XT60 de XT60i?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No debes comprar solo por color. Pide la referencia exacta del conector y la confirmación de compatibilidad con tu estación."
          }
        },
        {
          "@type": "Question",
          "name": "¿4 mm² significa que el cable mide 4 mm de diámetro?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. mm² expresa el área del conductor metálico. Solicita por separado la sección del conductor y el diámetro exterior del cable."
          }
        },
        {
          "@type": "Question",
          "name": "¿6 mm² siempre es la mejor compra?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Elige la sección que cumpla la aplicación y admita el conector. Compara distancia, corriente, caída de tensión, montaje y costo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Un adaptador permite conectar un panel de mayor voltaje?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Un adaptador pasivo no convierte el voltaje. El panel y su configuración deben permanecer dentro de los límites admitidos por la estación en las condiciones de uso previstas."
          }
        },
        {
          "@type": "Question",
          "name": "¿DDNZ puede preparar una prueba con bajo MOQ y mi marca?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Puedes solicitar esa propuesta. DDNZ confirmará el mínimo de cada referencia y el mínimo de personalización con tus modelos, cantidades y requisitos de empaque."
          }
        }
      ]
    },
