    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/blog/lcl-door-to-door-warehouse-unloading/#faq",
      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Does DDP include unloading at my warehouse?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under DDP, the goods are delivered ready for unloading at the named point. Confirm separately who performs unloading, whether the carriage price includes it, and where the handover occurs."
          }
        },
        {
          "@type": "Question",
          "name": "Is a liftgate enough if there is no loading dock?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A liftgate can lower compatible freight to ground level. Confirm that the platform and rated capacity suit the heaviest packed unit and that a suitable truck can stop on safe, level ground. Agree who moves the freight from that point."
          }
        },
        {
          "@type": "Question",
          "name": "When should I ask the warehouse to book a time slot?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ask for the warehouse’s notice period before you book freight. Confirm the slot with the local carrier once cargo availability and the dispatch plan are confirmed, allowing enough time to meet the warehouse’s booking deadline."
          }
        }
      ]
    },
