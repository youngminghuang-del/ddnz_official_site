    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/pl/blog/import-phone-cases-poland-gpsr-traceability/#faq",
      "inLanguage": "pl",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Czy kod kreskowy może być identyfikatorem produktu?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Może przenosić dane identyfikacyjne, jeżeli pozwala rozpoznać produkt zgodnie z wymaganiami. Sprawdź, co rzeczywiście koduje i czy oznaczenie widoczne dla konsumenta spełnia wymagania identyfikacji i czytelności."
          }
        },
        {
          "@type": "Question",
          "name": "Czy na każdym etui trzeba drukować numer partii?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "GPSR dopuszcza typ, numer partii, numer seryjny lub inny element identyfikacyjny. Ustal z dostawcą, jakie oznaczenie zastosuje i gdzie je umieści. Jeśli dostawca podaje partię, powiąż ją z wewnętrzną ewidencją."
          }
        },
        {
          "@type": "Question",
          "name": "Czy jedna oferta może obejmować kilka kolorów?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sprawdź zdjęcie, typ i dane identyfikacyjne dla każdego wybieranego wariantu. Odpowiednie dane podmiotów i wymagane ostrzeżenia powinny być wyraźnie widoczne w ofercie."
          }
        }
      ]
    },
