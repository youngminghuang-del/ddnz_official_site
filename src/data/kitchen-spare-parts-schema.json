    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/blog/commercial-kitchen-spare-parts-wholesale-china/#faq",
      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I get a reliable match from a photograph alone?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A photograph can start the search. Before accepting a fit claim, send the equipment nameplate, existing part markings and connection details. If the match remains unresolved, keep the item out of confirmed resale stock."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a different stock line for each equipment version?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Keep separate lines until interchangeability is confirmed. Where a documented replacement covers several versions, retain that cross-reference with the stock item so staff can check the application."
          }
        },
        {
          "@type": "Question",
          "name": "How many pieces should I buy first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Use your own service demand and available cash to propose a trial quantity. Ask for the item’s MOQ, sample terms and replenishment time. There is no single starting quantity that suits every part or dealer."
          }
        },
        {
          "@type": "Question",
          "name": "Does a replacement-parts warranty include local repair labour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only if the written terms include it. Agree the claim evidence, return requirements, replacement supply, labour and transport costs before paying."
          }
        }
      ]
    },
