    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/blog/china-new-york-new-jersey-lcl-christmas-pickup/#faq",
      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I collect LCL freight on the vessel arrival date?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan pickup from the destination CFS once it verifies that your HBL is available for collection, the applicable releases are in place, and a truck can collect within the station’s hours. Use the vessel arrival date to start those checks."
          }
        },
        {
          "@type": "Question",
          "name": "Does an arrival notice confirm that my cargo is available?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Check the arrival notice for shipment details and next steps. For dispatch, use the destination agent’s confirmed pickup status for your HBL and check for any remaining freight or customs hold."
          }
        },
        {
          "@type": "Question",
          "name": "Do Christmas and New Year’s Day count toward CFS storage?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ask the named station or destination agent how it counts holidays under the terms for your shipment. Request the exact last free day and local cutoff in writing before committing to a truck."
          }
        }
      ]
    },
