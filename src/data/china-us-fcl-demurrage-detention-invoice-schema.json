    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/blog/china-us-fcl-demurrage-detention-invoice/#faq",
      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which date should I use to track my request deadline?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a covered invoice, start with its issue date and check the issuer’s terms for any longer period. Submit through the listed channel and save the acknowledgment."
          }
        },
        {
          "@type": "Question",
          "name": "What if the invoice leaves out the applicable rate or dispute contact?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Identify the missing fields and request a complete invoice in writing. Part 541.5 ties payment obligation to the required information in § 541.6 for covered invoices. Keep the original and track your request from the original issue date while you seek clarification."
          }
        },
        {
          "@type": "Question",
          "name": "Can I dispute days when I could not book an empty return?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Document each attempt, including the specified depot, available slots or rejection message, and any revised return instruction. Ask the issuer to review the affected dates against those records."
          }
        }
      ]
    },
