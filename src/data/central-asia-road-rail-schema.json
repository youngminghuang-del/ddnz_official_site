      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/blog/china-central-asia-road-vs-rail/#faq",
      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is China–Europe rail fully booked?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Availability is specific to the departure and service. A sold-out route may have alternatives from another hub or to a nearby terminal. Ask for a confirmed booking with an onward delivery plan."
          }
        },
        {
          "@type": "Question",
          "name": "Does TIR guarantee a nonstop truck or a fixed delivery date?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "TIR provides a framework for customs transit under guarantee. The dispatch window, vehicle handovers, inspections and delivery schedule still depend on the route and booking."
          }
        },
        {
          "@type": "Question",
          "name": "How can I tell whether the Iran sea rate has risen for my shipment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Compare two dated offers for the same origin, destination, container type and service scope. Ask the forwarder to show which base rate or surcharge changed and whether the carrier still accepts the booking."
          }
        }
      ]
