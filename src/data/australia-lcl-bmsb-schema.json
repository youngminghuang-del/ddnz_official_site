    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/blog/australia-lcl-bmsb-container-hold/#faq",
      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I pick up as soon as my broker says “cleared”?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ask the warehouse or forwarder to confirm your own shipment is ready to collect. Then book the truck."
          }
        },
        {
          "@type": "Question",
          "name": "Can the warehouse take out my pallets before treatment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If Australian biosecurity officers require treatment of the container after arrival, the warehouse has to wait before taking out your pallets for normal delivery."
          }
        },
        {
          "@type": "Question",
          "name": "Who pays if someone else’s goods hold up my shipment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Check your booking terms. Ask for a written breakdown of the additional costs and how any shared charges are divided."
          }
        }
      ]
    },
