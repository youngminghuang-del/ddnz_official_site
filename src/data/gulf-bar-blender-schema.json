      "inLanguage": "en",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can I use another jar of the same capacity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ask for a written match against the base and jar part codes. Check the seating, drive connection and enclosure clearance on the sample before buying the spare."
          }
        },
        {
          "@type": "Question",
          "name": "What should I buy first for after-sales support?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Start by pricing a complete spare jar for the machine you plan to stock. Add separate blade kits or drive sockets where the supplier provides service instructions and your technicians can install them."
          }
        },
        {
          "@type": "Question",
          "name": "What should I send DDNZ for a trial quote?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Send the destination country and city, drinks and ingredients, busiest service pattern, electrical requirements and trial quantities. Add a machine or jar photo if you have one."
          }
        }
      ]
