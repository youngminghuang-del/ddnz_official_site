    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/ar/blog/saudi-cafe-ice-machine-vs-storage-bin/#faq",
      "inLanguage": "ar",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "الماكينة مكتوب عليها 100 كغ في اليوم. هل تكفي لساعتين؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "اطلب بيانات الموديل عند حرارة الهواء والماء في موقعك، ثم راقب وقت سقوط الدفعات خلال الساعتين. قارن كمية الثلج التي تصل قبل كل فترة سحب مع المخزون الموجود عند بدء الذروة."
          }
        },
        {
          "@type": "Question",
          "name": "الخزان مكتوب عليه 20 كغ. هل يحقق هدف 19 كغ في المثال؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "اطلب من المورد وزن الثلج القابل للسحب عند نقطة توقف حساس الامتلاء باستخدام شكل الثلج الذي ستشغّله. أعد القياس بعد فترة الانتظار المعتادة قبل الذروة ثم قارن الكمية المتبقية بهدف 19 كغ."
          }
        },
        {
          "@type": "Question",
          "name": "لماذا ينفد الثلج قبل انتهاء نصف الساعة رغم أن الرصيد المحسوب موجب؟",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "راجع وقت الطلبات ووقت وصول الدفعة. إذا وصل الثلج في آخر الفترة، فقد يظل مجموع النصف ساعة موجبًا رغم نفاد الرصيد قبل وصوله. قسّم الفترة إلى مقاطع أقصر أو سجّل السحب عند كل دفعة."
          }
        }
      ]
    },
