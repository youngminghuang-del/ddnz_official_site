    {
      "@type": "FAQPage",
      "@id": "https://www.ddnzglobal.com/es/blog/comparar-cotizaciones-lcl-china-centroamerica-sudamerica/#faq",
      "inLanguage": "es",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Puedo comparar dos precios por metro cúbico?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sí, cuando las dos líneas usan la misma base, el mismo mínimo y el mismo alcance. Pide además los importes por embarque y los cargos en destino para comparar el total hasta el punto acordado."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo registro un cargo de destino que todavía no tiene importe?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Déjalo como pendiente, con el nombre de quien lo debe cotizar y su unidad de cobro. Solicita su confirmación escrita antes de reservar si necesitas cerrar el costo hasta tu almacén."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué datos necesita DDNZ para revisar las ofertas?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Envía país y ciudad de entrega, descripción de la mercancía, número de bultos, dimensiones exteriores, peso bruto, ubicaciones de recogida y fecha estimada de disponibilidad. Si ya tienes dos ofertas, puedes ocultar los nombres comerciales y mantener visibles los importes y condiciones."
          }
        }
      ]
    },
